# Copia este archivo como .env (en esta misma carpeta) y completa los valores.
# .env está en .gitignore: nunca subas tu key real al repositorio.
# Las variables ya definidas en el sistema (p. ej. con setx) tienen prioridad.

# --- Google AI (requerido por la API) ---------------------------------------
# Crea la key en https://aistudio.google.com/apikey
GOOGLE_API_KEY=tu-api-key-aqui

# Modelo de embeddings: el MISMO para documentos y preguntas.
# Si lo cambias, borra la carpeta chroma/ y vuelve a ingestar (si no, /query da 409).
GOOGLE_EMBED_MODEL=gemini-embedding-001

# Modelo que redacta las respuestas (se puede cambiar sin reindexar).
GOOGLE_GEN_MODEL=gemini-3.8-flash

# --- Streamlit ----------------------------------------------------------------
# URL donde corre la API (uvicorn api:app --port 8000).
API_URL=http://localhost:8000

# El resto de la configuración (chunk_words, overlap, top_k, api_min_score,
# chroma_dir, docs_dir) está en config.yaml.
